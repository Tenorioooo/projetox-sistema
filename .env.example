# ============================================
# ProjetoX Produções — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Database
DB_PASSWORD=ProjetoX2026!SecurePass
DATABASE_URL=postgresql://projetox:ProjetoX2026!SecurePass@localhost:5432/projetox?schema=public

# JWT Authentication
JWT_SECRET=CHANGE-THIS-TO-A-RANDOM-STRING-WITH-AT-LEAST-32-CHARACTERS
JWT_EXPIRES_IN=8h

# QR Code Domain (used in QR code URLs)
QR_DOMAIN=https://seudominio.com

# SMTP Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password
SMTP_FROM=ProjetoX Produções <ingressos@projetox.com.br>

# Payment Provider (mock | mercadopago | stripe | asaas)
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
ASAAS_API_KEY=

# Webhook
WEBHOOK_SECRET=webhook-secret-change-in-production

# CORS
CORS_ORIGIN=http://localhost

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
